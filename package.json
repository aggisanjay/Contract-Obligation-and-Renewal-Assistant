{
  "name": "contract-obligation-and-renewal-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build": "node scripts/build.mjs",
    "start": "npx --workspace=backend prisma migrate deploy && node backend/dist/index.js",
    "test": "node ./node_modules/vitest/vitest.mjs run --root backend && node ./node_modules/vitest/vitest.mjs run --root frontend",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "dependencies": {
    "prisma": "^6.4.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.5.0",
    "typescript-eslint": "^8.71.0"
  }
}
