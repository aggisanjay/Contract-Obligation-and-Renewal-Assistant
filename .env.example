# Contract Obligation & Renewal Assistant - Environment Configuration

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@ep-sample-project.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Multi-Provider LLM Fallback Chain (Automatic Rate-Limit Rollover)
# If one provider hits a rate limit (HTTP 429) or quota exhaustion,
# the system automatically fails over to the next configured provider!
# Priority: Gemini -> Groq -> Hugging Face -> MockLLMClient (if none configured)

# 1. Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 2. Groq (Ultra-fast inference & generous free tier)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# 3. Hugging Face (Serverless Inference / Router API)
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODEL="Qwen/Qwen2.5-72B-Instruct"
